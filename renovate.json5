{
  "extends": [
    // Base config - https://github.com/giantswarm/renovate-presets/blob/main/default.json5
    "github>giantswarm/renovate-presets:default.json5",
    // Go specific config - https://github.com/giantswarm/renovate-presets/blob/main/lang-go.json5
    "github>giantswarm/renovate-presets:lang-go.json5",
  ],
  // The Dex image in the Dockerfile comes from giantswarm/dex: an upstream Dex
  // release plus our patches, released as X.Y.Z-gs.N (FORK.md on its giantswarm
  // branch). Only those tags count as versions, so Renovate skips the dev builds
  // (X.Y.Z-r<...>h<sha>) that the same image repository holds.
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["gsoci.azurecr.io/giantswarm/dex/dex"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-gs\\.(?<build>\\d+)$",
    },
  ],
}
